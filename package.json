{
  "name": "blockboard",
  "displayName": "Blockboard",
  "description": "A visual library for HTML/CSS components and code snippets.",
  "license": "AGPL-3.0-only",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/BCnD-Labs/blockboard.git"
  },
  "bugs": {
    "url": "https://github.com/BCnD-Labs/blockboard/issues"
  },
  "keywords": [
    "snippets",
    "components",
    "html",
    "css",
    "library"
  ],
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Snippets"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "blockboard.saveBlock",
        "title": "Save Block",
        "category": "Blockboard",
        "icon": "$(add)"
      },
      {
        "command": "blockboard.listBlocks",
        "title": "List Blocks",
        "category": "Blockboard"
      },
      {
        "command": "blockboard.deleteBlock",
        "title": "Delete Block",
        "category": "Blockboard"
      },
      {
        "command": "blockboard.insertBlock",
        "title": "Insert Block",
        "category": "Blockboard"
      },
      {
        "command": "blockboard.editBlock",
        "title": "Edit Block",
        "category": "Blockboard"
      },
      {
        "command": "blockboard.refreshSidebar",
        "title": "Refresh Sidebar",
        "category": "Blockboard",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "blockboard",
          "title": "Blockboard",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "blockboard": [
        {
          "type": "webview",
          "id": "blockboard.sidebar",
          "name": "Blocks",
          "icon": "media/icon.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "blockboard.saveBlock",
          "when": "view == blockboard.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "blockboard.refreshSidebar",
          "when": "view == blockboard.sidebar",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "blockboard.refreshSidebar",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Blockboard",
      "properties": {
        "blockboard.storageMode": {
          "type": "string",
          "enum": [
            "folder",
            "globalState"
          ],
          "default": "folder",
          "description": "Where saved blocks are kept. 'folder' survives uninstalling the extension; 'globalState' lives inside VS Code and may not."
        },
        "blockboard.libraryPath": {
          "type": "string",
          "default": "",
          "description": "Folder for saved blocks when the mode is 'folder'. Leave empty to use ~/Blockboard."
        },
        "blockboard.tileSize": {
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large"
          ],
          "enumDescriptions": [
            "About three tiles per row in a default-width sidebar.",
            "About two tiles per row.",
            "About one tile per row."
          ],
          "default": "small",
          "description": "Size of the block tiles in the sidebar."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run build:webview",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "build:webview": "esbuild webview/editor.js --bundle --minify --outfile=media/editor.js",
    "watch:webview": "esbuild webview/editor.js --bundle --outfile=media/editor.js --watch"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
